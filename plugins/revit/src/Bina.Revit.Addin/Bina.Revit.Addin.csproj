<Project Sdk="Microsoft.NET.Sdk">
  <!-- Choisir la version de Revit à la compilation :  dotnet build -c Release -p:RevitVersion=2025
       2022 à 2024 : .NET Framework 4.8 ; 2025 et plus : .NET 8.
       Les fichiers RevitAPI.dll / RevitAPIUI.dll viennent d'un paquet NuGet public ; ils ne sont JAMAIS dans le dépôt.
       Autre possibilité : définir RevitInstallDir (ex. C:\Program Files\Autodesk\Revit 2025) pour utiliser les fichiers de votre Revit. -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)'==''">2024</RevitVersion>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2025">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &lt; 2025">net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Bina.Revit</RootNamespace>
    <AssemblyName>Bina.Revit.Addin</AssemblyName>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bina.Revit.Core\Bina.Revit.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitInstallDir)'==''">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitInstallDir)'!=''">
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
